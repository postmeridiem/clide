# Caddy for the web UI (D-117). The edge serves the WebAssembly bundle
# itself, asks the broker about every request outside /auth/, and passes
# /auth/ to the broker, which signs browsers in (D-118). The broker starts
# Caddy and supervises it (D-120), and listens on the unix socket below.
{
	# The container runs unprivileged, so no port below 1024.
	http_port 8080
	https_port 8443
	# Certificates come from Caddy's internal CA only, never from ACME. An
	# unprivileged process can't add that CA to the system trust store, so
	# Caddy doesn't try.
	local_certs
	skip_install_trust
	auto_https disable_redirects
	admin off
}

localhost:8443 {
	tls internal

	# Cross-origin isolation, for Skwasm's threads (SharedArrayBuffer).
	header {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		# Flutter's web output has fixed names, not content hashes, so every
		# response is revalidated. An upgraded image then can't be masked by
		# a cached old main.dart.wasm.
		Cache-Control no-cache
	}

	# The broker's answer to "may this request pass?" is for Caddy alone.
	handle /auth/verify {
		respond 404
	}

	# Signing in and out are the broker's own pages.
	handle /auth/* {
		reverse_proxy unix//clide/state/run/broker.sock
	}

	# `route` keeps the order written here. Caddy's default order would rewrite
	# a workspace URL to /index.html before the broker saw it, hiding whose
	# /u/<N>/ path it was and where to return after signing in.
	handle {
		route {
			# Every other request needs a session the broker accepts. Without
			# one, a page is sent to sign in and anything else gets a 401.
			forward_auth unix//clide/state/run/broker.sock {
				uri /auth/verify
			}

			# Workspace URLs (D-116) all load the app. Any other missing path
			# stays a 404, so a lost asset fails loudly instead of returning
			# index.html.
			@workspace path /u/*
			rewrite @workspace /index.html

			root * /srv/web
			file_server {
				precompressed br gzip
			}
		}
	}
}
